---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getUrl } from '../utils/url';

const title = "Contact | Night Sky Journey Portfolio";
const description = "Get in touch for collaborations, projects, or other inquiries.";

const web3FormsAccessKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY?.trim() ?? "";

---

<BaseLayout title={title} description={description}>
  <section class="min-h-screen pt-32 pb-20 px-6 md:px-12 lg:px-20 bg-background text-secondary transition-colors duration-300">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24">
      
      <!-- Contact Info & Context -->
      <div class="space-y-12">
        <div>
          <h1 class="font-serif text-4xl md:text-5xl lg:text-6xl text-primary mb-6 tracking-tight">
            Let's Create Together
          </h1>
          <p class="text-lg font-light leading-relaxed text-secondary max-w-md">
            I'm currently accepting new commissions for 2026. Whether you have a specific project in mind or just want to discuss possibilities, I'd love to hear from you.
          </p>
        </div>

        <div class="space-y-6">
          <div>
            <h2 class="text-primary font-medium mb-2">Email</h2>
            <a href="mailto:" class="text-secondary hover:text-primary transition-colors">
              moraru_costel at yahoo.com
            </a>
          </div>
          <div>
            <h2 class="text-primary font-medium mb-2">Studio</h2>
            <p class="text-secondary">
              Amateur Astrophotography<br>
              Germany, Bayern
            </p>
          </div>
        </div>
      </div>

      <!-- Inquiry Form -->
      <div class="bg-surface/50 p-8 md:p-10 rounded-lg border border-border">
        <form
          id="contact-form"
          action="https://api.web3forms.com/submit"
          method="POST"
          class="space-y-8"
          novalidate
        >
          <input type="hidden" name="access_key" value={web3FormsAccessKey} />
          <input type="hidden" name="subject" value="New message from Night Sky Journey" />
          <input type="hidden" name="from_name" value="Night Sky Journey Contact Form" />
          <input
            type="checkbox"
            name="botcheck"
            class="hidden"
            style="display: none"
            tabindex="-1"
            aria-hidden="true"
          />
          
          <!-- Name & Email -->
          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div class="space-y-2">
              <label for="name" class="block text-sm font-medium text-primary">Name</label>
              <input 
                type="text" 
                id="name" 
                name="name" 
                required
                aria-describedby="name-error"
                class="w-full bg-background border border-border rounded-md px-4 py-3 text-primary focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors data-[invalid=true]:border-red-500"
                placeholder="Jane Doe"
              />
              <p id="name-error" class="hidden text-red-500 text-sm mt-1" role="alert"></p>
            </div>
            <div class="space-y-2">
              <label for="email" class="block text-sm font-medium text-primary">Email</label>
              <input 
                type="email" 
                id="email" 
                name="email" 
                required
                aria-describedby="email-error"
                class="w-full bg-background border border-border rounded-md px-4 py-3 text-primary focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors data-[invalid=true]:border-red-500"
                placeholder="jane@example.com"
              />
              <p id="email-error" class="hidden text-red-500 text-sm mt-1" role="alert"></p>
            </div>
          </div>

          <!-- Project Details -->
          <div class="space-y-2">
            <label for="message" class="block text-sm font-medium text-primary">Project Details</label>
            <textarea 
              id="message" 
              name="message" 
              rows="5" 
              required
              aria-describedby="message-error"
              class="w-full bg-background border border-border rounded-md px-4 py-3 text-primary focus:outline-none focus:border-primary focus:ring-1 focus:ring-primary transition-colors resize-none data-[invalid=true]:border-red-500"
              placeholder="Tell me about your vision, timeline, and any specific requirements..."
            ></textarea>
            <p id="message-error" class="hidden text-red-500 text-sm mt-1" role="alert"></p>
          </div>

          <!-- Submit Button -->
          <button 
            type="submit" 
            class="w-full bg-primary text-background font-medium py-4 rounded-md hover:opacity-90 transition-all focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-primary"
          >
            Send Inquiry
          </button>

          <!-- Status Message Area -->
          <div id="form-status" class="hidden text-center text-sm pt-4" role="alert"></div>
          <p class="text-xs text-secondary text-center">
            Your details are used to respond to your inquiry. See our
            <a href={getUrl("/privacy")} class="underline hover:text-primary transition-colors">
              Privacy &amp; Cookies notice
            </a>.
          </p>

        </form>
      </div>

    </div>
  </section>

<script>
  import { handleDemoFormSubmit } from '../utils/demo-form-handler';
  import { sendContactMessage } from '../utils/contact-form';

  const form = document.getElementById('contact-form') as HTMLFormElement;
  
  if (form) {
    // Disable default HTML5 validation bubbles to use our custom UI
    form.noValidate = true;

    form.addEventListener('submit', async (e) => {
      let isValid = true;
      const inputs = form.querySelectorAll('input[required], textarea[required]');

      inputs.forEach((input) => {
        const field = input as HTMLInputElement | HTMLTextAreaElement;
        const errorId = field.getAttribute('aria-describedby');
        const errorEl = errorId ? document.getElementById(errorId) : null;
        
        // Reset state
        field.removeAttribute('data-invalid');
        field.setAttribute('aria-invalid', 'false');
        if (errorEl) {
          errorEl.classList.add('hidden');
          errorEl.textContent = '';
        }

        if (!field.value.trim()) {
          isValid = false;
          showError(field, errorEl, `${field.name.charAt(0).toUpperCase() + field.name.slice(1)} is required`);
        } else if (field.type === 'email' && !validateEmail(field.value)) {
          isValid = false;
          showError(field, errorEl, 'Please enter a valid email address');
        }
      });

      if (!isValid) {
        e.preventDefault();
        // Focus first invalid field
        const firstInvalid = form.querySelector('[data-invalid="true"]') as HTMLElement;
        if (firstInvalid) firstInvalid.focus();
        return;
      }

      e.preventDefault();

      const handled = await handleDemoFormSubmit(
        e,
        setLoading,
        (message) => showStatus(message, true),
        1500 // Increased delay for testing visibility
      );

      if (handled) return;

      const formData = new FormData(form);
      if (!String(formData.get('access_key') ?? '').trim()) {
        showStatus(
          'The contact form is not configured yet. Please email moraru_costel at yahoo com directly.',
          false
        );
        return;
      }

      setLoading(true);
      try {
        await sendContactMessage(formData);
        showStatus('Thanks! Your message has been sent.', true);
        form.reset();
      } catch (error) {
        console.error('Contact form submission failed:', error);
        showStatus(
          'Your message could not be sent. Please try again or email moraru_costel at yahoo com directly.',
          false
        );
      } finally {
        setLoading(false);
      }
    });

    // Real-time validation clearing
    form.addEventListener('input', (e) => {
      const field = e.target as HTMLInputElement;
      if (field.hasAttribute('data-invalid')) {
         field.removeAttribute('data-invalid');
         field.setAttribute('aria-invalid', 'false');
         const errorId = field.getAttribute('aria-describedby');
         const errorEl = errorId ? document.getElementById(errorId) : null;
         if (errorEl) errorEl.classList.add('hidden');
      }
      
      // Clear global status on input
      const status = document.getElementById('form-status');
      if (status && !status.classList.contains('hidden')) {
        status.classList.add('hidden');
        status.textContent = '';
        status.classList.remove('text-red-500', 'text-green-500');
      }
    });
  }

  function setLoading(loading: boolean) {
    const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
    if (loading) {
      btn.disabled = true;
      if (!btn.dataset.originalText) btn.dataset.originalText = btn.textContent || '';
      btn.textContent = 'Sending...';
    } else {
      btn.disabled = false;
      btn.textContent = btn.dataset.originalText || 'Send Inquiry';
    }
  }

  function showStatus(message: string, success: boolean) {
    const status = document.getElementById('form-status');
    if (!status) return;

    status.textContent = message;
    status.classList.remove('hidden', 'text-red-500', 'text-green-500');
    status.classList.add(success ? 'text-green-500' : 'text-red-500');
  }

  function showError(field: HTMLElement, errorEl: HTMLElement | null, message: string) {
    field.setAttribute('data-invalid', 'true');
    field.setAttribute('aria-invalid', 'true');
    if (errorEl) {
      errorEl.textContent = message;
      errorEl.classList.remove('hidden');
    }
  }

  function validateEmail(email: string) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  }
</script>
